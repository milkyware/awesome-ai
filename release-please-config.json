{
  "exclude-paths": [".git", ".claude-plugin", ".idea", ".vscode", "build"],
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "include-v-in-release-name": true,
  "tag-separator": "-",
  "separate-pull-requests": true,
  "changelog-sections": [
    { "type": "breaking", "section": "⛓️‍💥 Breaking Changes" },
    { "type": "feat", "section": "🚀 Enhancements" },
    { "type": "perf", "section": "🚀 Enhancements" },
    { "type": "fix", "section": "🩹 Fixes" },
    { "type": "docs", "section": "📖 Documentation" },
    { "type": "refactor", "section": "♻️ Refactoring" },
    { "type": "test", "section": "✅ Tests" },
    { "type": "build", "section": "🏗️ Build & Automation" },
    { "type": "ci", "section": "🏗️ Build & Automation" },
    { "type": "chore", "section": "🧹 Maintenance" },
    { "type": "revert", "section": "⏪ Reverts" }
  ],
  "packages": {
    "plugins/architecture-docs": {
      "component": "architecture-docs",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "apm.yml",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
